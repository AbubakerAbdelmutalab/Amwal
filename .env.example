# Copy to .env.local for development. Set the same names in Vercel
# (Project → Settings → Environment Variables) for production, marked Sensitive.
# Never commit real values.

# Encryption keys for personal data: 32 random bytes each, base64.
# Generate with: npm run keys:generate
# Back them up safely. Data encrypted with a lost key cannot be recovered.
DATA_ENCRYPTION_KEY=
DATA_HASH_KEY=
# Only during key rotation: the old encryption key, so old data stays readable.
DATA_ENCRYPTION_KEY_PREVIOUS=

# Hosted Postgres (Supabase transaction pooler, port 6543). In production the
# Vercel Supabase integration sets POSTGRES_URL, which is used if this is empty.
# Leave empty in development to use the local embedded database in ./.data.
DATABASE_URL=

# Stripe (test keys start with sk_test_). Set by the Vercel Stripe integration
# or from the Stripe dashboard. Never commit.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Public site address for Stripe return links (defaults to the Vercel URL).
SITE_URL=

# Live site only: set to true to open booking to the public.
BOOKING_OPEN=

# Admin sign-in (npm run admin:setup)
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=

{
  "name": "amwal-school",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --conditions=react-server --test \"tests/**/*.test.ts\"",
    "db:migrate": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/migrate.mts",
    "keys:generate": "tsx scripts/generate-keys.ts",
    "test:e2e": "tsx --conditions=react-server --env-file-if-exists=.env.local --test tests/e2e/admin.e2e.mts",
    "admin:setup": "tsx --conditions=react-server scripts/admin-setup.mts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "drizzle-orm": "^0.45.4",
    "next": "^16.0.0",
    "postgres": "^3.4.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright-core": "^1.65.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0"
  }
}
